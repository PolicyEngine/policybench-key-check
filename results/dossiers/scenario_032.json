 "board_exclusion_records": [
  {
   "scenario_id": "scenario_032",
   "variable": "payroll_tax",
   "reason_code": "reference_depends_on_unlisted_input",
   "alternative_reading": "The prompt defines payroll_tax as employee Social Security, Medicare and Additional Medicare Tax plus mandatory employee state payroll taxes, and says to exclude employer payroll taxes. Minnesota Paid Leave premiums \"accrue and become payable by each employer\" (Minn. Stat. 268B.14, subd. 1); the employer must pay at least 50 percent (small employers: at least a quarter of the full rate, subd. 5a), and employees pay through wage deductions only \"the remaining portion, if any, of the premium not paid by the employer\" (subd. 3), so the employee share runs from 0 to 0.44% of wages at the employer's choice. The reference reads 'mandatory' as the employee share the statute sets, withheld unless the employer elects to pay it, and counts the largest share the employer may deduct (mn_employee_paid_leave_contribution $127.60), as policyengine-us assumes. Read as the amount the law requires of the employee whatever the employer does, which is $0, the output is employee federal payroll tax alone: the alternative value (policyengine-us 2.15.17 with latest_final and payroll_mandatory_scope).",
   "frozen_value": 2346.10009765625,
   "alternative_value": 2218.5,
   "engine_version": "policyengine-us 2.15.17",
   "decided_on": "2026-10-05",
   "decided_by": "developer",
   "unlisted_input": "whether the employer deducts the employee share of a state paid-leave or disability premium that the law lets it deduct but does not require, which decides whether that share is a mandatory employee state payroll tax",
   "note": "Found 2026-10-05 by classifying every state program in the payroll references from primary law (reference_audit/2026-10-05-payroll/program_classification.json) and sweeping all 1,984 outputs with the programs classified as optional employer pass-through left out of employee state payroll tax; that moves this output alone in its household and no other output. The law: Minn. Stat. 268B.14, subds. 1, 3 and 5a. The frozen value has been the reference since the first run (references generated 2026-06-12)."
  }
 ],
